{
  "name": "trmnl-games",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @trmnl-games/web dev",
    "build": "pnpm --filter @trmnl-games/web build",
    "preview": "pnpm --filter @trmnl-games/web preview",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.sim.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "tsx tools/balance/run.ts",
    "balance:raids": "tsx tools/balance/raids.ts",
    "balance:meetings": "tsx tools/balance/meetings.ts",
    "balance:lost-property": "tsx tools/balance/lostProperty.ts",
    "balance:standoffs": "tsx tools/balance/standoffs.ts",
    "lint:trmnl:setup": "tsx tools/trmnl/lint.ts --install",
    "lint:trmnl": "tsx tools/trmnl/lint.ts",
    "crosscheck:trmnl": "tsx tools/trmnl/crosscheck.ts",
    "sweep:trmnl": "node tools/trmnl/sweep.mjs",
    "pull:trmnl": "node tools/trmnl/pull-live.mjs",
    "check": "pnpm typecheck && pnpm test",
    "knip": "knip",
    "build:deploy": "node tools/deploy/check-target.mjs && pnpm check && convex deploy -y --cmd 'pnpm build'",
    "deploy:web": "pnpm --filter @trmnl-games/web run deploy",
    "balance:idle-angler": "tsx tools/balance/idle-angler.ts",
    "balance:paper-lives": "tsx tools/balance/paper-lives.ts",
    "balance:little-plot": "tsx tools/balance/little-plot.ts",
    "preview:idle-angler": "tsx tools/trmnl/preview-idle-angler.ts --inline-art",
    "preview:paper-lives": "tsx tools/trmnl/preview-paper-lives.ts --inline-art",
    "preview:little-plot": "tsx tools/trmnl/preview-little-plot.ts --inline-art",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm knip"
  },
  "devDependencies": {
    "@clerk/tanstack-react-start": "^1.7.1",
    "@edge-runtime/vm": "^5.0.0",
    "@tanstack/react-start": "^1.168.61",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "convex-test": "^0.0.61",
    "jsqr": "^1.4.0",
    "knip": "^6.41.0",
    "liquidjs": "^10.30.0",
    "playwright-core": "1.64.0",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@trmnl-games/backend": "workspace:*",
    "@trmnl-games/desk-crawler": "workspace:*",
    "@trmnl-games/engine": "workspace:*",
    "@trmnl-games/platform": "workspace:*",
    "@trmnl-games/idle-angler": "workspace:*",
    "@trmnl-games/little-plot": "workspace:*",
    "@trmnl-games/paper-lives": "workspace:*",
    "convex": "^1.46.0",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
