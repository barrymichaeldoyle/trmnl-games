{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // Tool scripts run by hand with `pnpm tsx tools/...`.
      // tools/review/capture-companion.js is pasted into the browser console.
      "entry": ["tools/**/*.{ts,mjs}", "tools/review/capture-companion.js"],
      // tests/web/reconnection-handoff.test.ts mocks these by bare name, which Vitest resolves from the repo root.
      "ignoreDependencies": ["@tanstack/react-start", "@clerk/tanstack-react-start"]
    },
    "apps/web": {
      // Registered at runtime by src/lib/push.ts.
      "entry": ["public/push-sw.js"]
    }
  },
  // `cloudflare:workers` is a Workers runtime module, not a package.
  "ignoreDependencies": ["cloudflare"],
  // tools/trmnl/bundle.ts shells out to Ruby for the TRMNL linter.
  "ignoreBinaries": ["ruby"]
}
